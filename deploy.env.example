# Скопируй в deploy.env (он не попадает в git) и заполни.
HOST=practice.example.com        # домен; A-запись должна смотреть на сервер
DROPLET=root@203.0.113.10        # ssh-доступ к серверу
DROPLET_IP=203.0.113.10
KEY=$HOME/.ssh/id_ed25519
SLUG=practice                    # имя папки /var/www/<slug> и вхоста nginx
CERTBOT_EMAIL=you@example.com
